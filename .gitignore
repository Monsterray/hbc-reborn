# --- Wii keys: keep the keys/ folder, never its contents -------------------
/keys/*
!/keys/.gitkeep
*keys.bin
otp.bin
common-key
sd-key
sd-iv
md5-blanker
root-key
korean-key
*.pem

# --- Build output -----------------------------------------------------------
*.o
*.d
.deps/
*.a
*.exe
*.elf
*.dol
*.map
*.wad
*.part

# Channel app
/channel/channelapp/build/
/channel/channelapp/dist/
/channel/channelapp/stub.bin
/channel/channelapp/i18n/merge
/channel/channelapp/i18n/*.gen
/channel/channelapp/banner/twintig
/channel/channelapp/banner/banner.bin

# Banner and WAD packaging
/channel/banner/build/
/channel/banner/channel.imet
/channel/banner/tools/mkbns
/channel/banner/tools/lz77
/channel/title/00000000
/channel/title/00000001
/channel/title/*/cetk
/channel/title/*/tmd
/channel/title/title.stamp
/channel/channelapp/title_id.h

# Host tools
/channel/wiiload/wiiload
/wiipax/client/wiipax
/wiipax/client/x.lzma
/wiipax/stub/stub_*.c

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

